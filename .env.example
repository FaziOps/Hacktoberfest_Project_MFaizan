# auto: Gemma 4 through the Gemini API, falling back to offline Gemma 4 in Ollama
# gemini: Gemini API only    ollama: offline only
BACKEND=auto

# Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemma-4-26b-a4b-it
# Gemma 4 models to switch to when the main one errors (comma-separated)
GEMINI_FALLBACK_MODELS=gemma-4-31b-it

OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=gemma4:latest
